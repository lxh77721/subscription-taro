## 服务端口
SERVER_PORT=3000

## 微信小程序（服务端专用，切勿下发到前端）
WX_APPID=wxXXXXXXXXXXXXXXXX
WX_APPSECRET=你的AppSecret
## 订阅消息模板 ID（微信公众平台 - 订阅消息 - 选用模板）
## 模板字段需包含：thing1(名称) / time2(时间) / amount3(金额) / number5(天数)
WX_TMPL_ID=你的模板ID
## formal=正式版 / trial=体验版 / developer=开发版
WX_MINI_STATE=formal

## 会话令牌签名密钥（生产环境务必修改为随机长字符串）
AUTH_SECRET=请修改为随机字符串

## 管理接口（/api/reminder/list|run|clear）访问密钥
ADMIN_TOKEN=请设置一个管理密钥

## 本地/H5 调试时允许匿名访问（不校验令牌）；生产环境请删除或置为 0
ALLOW_ANONYMOUS=1

## 允许跨域的来源（逗号分隔，H5 调试用）
CORS_ORIGINS=http://localhost:5000

## Supabase（由平台注入；本地自托管时填写）
# COZE_SUPABASE_URL=
# COZE_SUPABASE_ANON_KEY=
# COZE_SUPABASE_SERVICE_ROLE_KEY=
